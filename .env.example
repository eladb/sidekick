# Copy to .env and source it, or export these directly, before running
# scripts/install.sh. Nothing here is required — install.sh will generate
# AUTH_TOKEN/SERVER_ID for you if unset — these are just the knobs you can
# override.

# AUTH_TOKEN=          # bearer credential for every service; auto-generated if unset
# SERVER_ID=           # short id embedded in the token; auto-generated if unset
# SIDEKICK_WATCH_TRANSPORT=websocket   # or "webrtc" for lower-latency watch-along (needs STUN/TURN below)
# SIDEKICK_STUN_HOST=
# SIDEKICK_STUN_PORT=
# SIDEKICK_TURN_HOST=
# SIDEKICK_TURN_PORT=
# SIDEKICK_TURN_PROTOCOL=
# SIDEKICK_TURN_USERNAME=
# SIDEKICK_TURN_PASSWORD=
# SIDEKICK_TURN_SHARED_SECRET=

# --- fly.io ---
# SIDEKICK_FLY_APP=
# SIDEKICK_FLY_REGION=iad
# SIDEKICK_FLY_ORG=

# --- EC2 ---
# SIDEKICK_EC2_REGION=us-east-1
# SIDEKICK_EC2_INSTANCE_TYPE=t3.small
# SIDEKICK_EC2_AMI=            # override if the Debian-12 AMI auto-lookup fails

# --- Hetzner ---
# SIDEKICK_HETZNER_TYPE=cx32
# SIDEKICK_HETZNER_LOCATION=nbg1

# --- Docker (optional convenience path) ---
# SIDEKICK_IMAGE=ghcr.io/eladb/sidekick:latest
# SIDEKICK_CONTAINER_NAME=sidekick
# SIDEKICK_BUILD_LOCAL=false

# SIDEKICK_REPO=eladb/sidekick  # used by ec2/hetzner to fetch provision.sh at boot
# SIDEKICK_REPO_REF=main
# SIDEKICK_TOKEN_FILE=./sidekick-token.txt
