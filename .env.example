# Copy to .env and source it, or export these directly, before running
# scripts/install.sh. Nothing here is required unless noted — install.sh will
# generate AUTH_TOKEN/SERVER_ID for you if unset — these are just the knobs you
# can override.

# AUTH_TOKEN=          # bearer credential for every service; auto-generated if unset
# SERVER_ID=           # short id embedded in the token; auto-generated if unset

# --- fly.io ---  (driven through the fly Machines API; no flyctl needed)
# FLY_API_TOKEN=       # REQUIRED for fly; `flyctl tokens create org` or the dashboard
# SIDEKICK_FLY_APP=
# SIDEKICK_FLY_REGION=iad
# SIDEKICK_FLY_ORG=personal
# SIDEKICK_FLY_CPUS=2
# SIDEKICK_FLY_MEMORY=2048
# SIDEKICK_FLY_IMAGE=ghcr.io/eladb/sidekick:latest   # image pulled by default
# SIDEKICK_FROM_SOURCE=                # set to 1 to install from source at boot
#                                      # instead of pulling the image (~10-12 min)

# --- EC2 ---  (uses the aws CLI's configured credentials)
# SIDEKICK_EC2_REGION=us-east-1
# SIDEKICK_EC2_INSTANCE_TYPE=t3.small
# SIDEKICK_EC2_AMI=            # override if the Debian-12 AMI auto-lookup fails

# --- Hetzner ---  (needs HCLOUD_TOKEN, plus cloudflared + python3 on the installer)
# HCLOUD_TOKEN=        # REQUIRED for Hetzner; from the Hetzner Cloud console
# SIDEKICK_HETZNER_TYPE=cpx22
# SIDEKICK_HETZNER_LOCATION=nbg1

# --- Docker (optional convenience path) ---
# SIDEKICK_IMAGE=ghcr.io/eladb/sidekick:latest
# SIDEKICK_CONTAINER_NAME=sidekick
# SIDEKICK_BUILD_LOCAL=false   # set true to build the image locally instead of pulling

# --- source fetch (EC2/Hetzner fetch provision.sh at boot; fly source mode too) ---
# SIDEKICK_REPO=eladb/sidekick
# SIDEKICK_REPO_REF=main
# SIDEKICK_TOKEN_FILE=./sidekick-token.txt
