# Rendered into /etc/supervisor/conf.d/sidekick.conf by
# configure-and-start.sh, which substitutes __AUTH_TOKEN__.

[program:xvfb]
command=/usr/bin/Xvfb :99 -screen 0 1280x800x24 -nolisten tcp
autorestart=true
priority=10
stdout_logfile=/var/log/sidekick/xvfb.log
stderr_logfile=/var/log/sidekick/xvfb.log

[program:openbox]
command=/usr/bin/openbox
environment=DISPLAY=":99"
autorestart=true
priority=20
stdout_logfile=/var/log/sidekick/openbox.log
stderr_logfile=/var/log/sidekick/openbox.log

[program:chromium]
command=/usr/bin/chromium --remote-debugging-port=9222 --remote-debugging-address=0.0.0.0 --remote-allow-origins=* --no-sandbox --disable-dev-shm-usage --disable-gpu --window-size=1280,800 --start-maximized about:blank
environment=DISPLAY=":99"
autorestart=true
priority=30
stdout_logfile=/var/log/sidekick/chromium.log
stderr_logfile=/var/log/sidekick/chromium.log

# cdpjson: stdlib shim in front of Chrome's /json* DevTools endpoints. Chrome
# rejects non-localhost Host headers (HTTP 500) and echoes the Host into the
# reported webSocketDebuggerUrl, which breaks connectOverCDP(cdp_url) through
# the tunnel. This fetches with Host: localhost and rewrites the ws URL to the
# public host. Caddy routes /json* here (with basic_auth); binds localhost only.
[program:cdpjson]
command=/usr/bin/python3 /opt/sidekick/cdpjson/cdpjson.py
environment=SIDEKICK_CDPJSON_PORT="9223",SIDEKICK_CDP_UPSTREAM_PORT="9222"
autorestart=true
priority=35
stdout_logfile=/var/log/sidekick/cdpjson.log
stderr_logfile=/var/log/sidekick/cdpjson.log

# Watch-along: x11vnc exposes display :99 as VNC on localhost:5900; websockify
# serves the noVNC web client and bridges the browser WebSocket to that VNC
# port on :6080. Caddy fronts :6080 at the root path with basic_auth. No
# password on x11vnc itself — it's localhost-only and gated by Caddy.
[program:x11vnc]
command=/usr/bin/x11vnc -display :99 -forever -shared -rfbport 5900 -localhost -nopw -quiet
environment=DISPLAY=":99"
autorestart=true
priority=40
stdout_logfile=/var/log/sidekick/x11vnc.log
stderr_logfile=/var/log/sidekick/x11vnc.log

[program:novnc]
command=/usr/bin/websockify --web=/usr/share/novnc 6080 localhost:5900
autorestart=true
priority=45
stdout_logfile=/var/log/sidekick/novnc.log
stderr_logfile=/var/log/sidekick/novnc.log

[program:ttyd]
command=/usr/local/bin/ttyd -p 7681 -b /shell -c sidekick:__AUTH_TOKEN__ bash
autorestart=true
priority=40
stdout_logfile=/var/log/sidekick/ttyd.log
stderr_logfile=/var/log/sidekick/ttyd.log

[program:execd]
command=/usr/bin/python3 /opt/sidekick/execd/execd.py
environment=SIDEKICK_AUTH_TOKEN="__AUTH_TOKEN__",SIDEKICK_EXECD_PORT="8090"
autorestart=true
priority=40
stdout_logfile=/var/log/sidekick/execd.log
stderr_logfile=/var/log/sidekick/execd.log

[program:caddy]
command=/usr/bin/caddy run --config /etc/sidekick/Caddyfile --adapter caddyfile
autorestart=true
priority=50
stdout_logfile=/var/log/sidekick/caddy.log
stderr_logfile=/var/log/sidekick/caddy.log

[program:cloudflared]
command=/usr/bin/cloudflared tunnel --url http://localhost:80 --no-autoupdate --logfile /var/log/sidekick/cloudflared.log
autorestart=true
priority=60
stdout_logfile=/var/log/sidekick/cloudflared-stdout.log
stderr_logfile=/var/log/sidekick/cloudflared-stdout.log

[program:tunnel-watcher]
command=/usr/local/bin/sidekick-tunnel-watcher
environment=SERVER_ID="__SERVER_ID__",SIDEKICK_RENDEZVOUS_URL="__RENDEZVOUS_URL__",SIDEKICK_RENDEZVOUS_SECRET="__RENDEZVOUS_SECRET__"
autorestart=true
priority=70
stdout_logfile=/var/log/sidekick/tunnel-watcher.log
stderr_logfile=/var/log/sidekick/tunnel-watcher.log

# --- Webapp hosting (static + CGI) on a second, public tunnel ---------------
# fcgiwrap executes CGI scripts under /srv/sidekick/cgi-bin; Caddy's :8080 site
# talks FastCGI to it (see Caddyfile). spawn-fcgi keeps it in the foreground so
# supervisord can manage it.
[program:fcgiwrap]
command=/usr/bin/spawn-fcgi -n -a 127.0.0.1 -p 9000 -- /usr/sbin/fcgiwrap
autorestart=true
priority=45
stdout_logfile=/var/log/sidekick/fcgiwrap.log
stderr_logfile=/var/log/sidekick/fcgiwrap.log

# Second cloudflared quick tunnel dedicated to the public webapp (Caddy :8080).
[program:webapp-tunnel]
command=/usr/bin/cloudflared tunnel --url http://localhost:8080 --no-autoupdate --logfile /var/log/sidekick/webapp-cloudflared.log
autorestart=true
priority=60
stdout_logfile=/var/log/sidekick/webapp-cloudflared-stdout.log
stderr_logfile=/var/log/sidekick/webapp-cloudflared-stdout.log

[program:webapp-tunnel-watcher]
command=/usr/local/bin/sidekick-tunnel-watcher
environment=SERVER_ID="__SERVER_ID__",SIDEKICK_CLOUDFLARED_LOG="/var/log/sidekick/webapp-cloudflared.log",SIDEKICK_URL_SENTINEL="SIDEKICK_WEBAPP_URL",SIDEKICK_RENDEZVOUS_FIELD="webapp_url",SIDEKICK_RENDEZVOUS_URL="__RENDEZVOUS_URL__",SIDEKICK_RENDEZVOUS_SECRET="__RENDEZVOUS_SECRET__"
autorestart=true
priority=70
stdout_logfile=/var/log/sidekick/webapp-tunnel-watcher.log
stderr_logfile=/var/log/sidekick/webapp-tunnel-watcher.log
